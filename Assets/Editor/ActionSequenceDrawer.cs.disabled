﻿using UnityEditor;
using UnityEngine;

[CustomPropertyDrawer(typeof(ActionData))]
public class ActionSequenceDrawer : PropertyDrawer
{
    private readonly float lineHeight = EditorGUIUtility.singleLineHeight;
    private readonly float spacing = 6f; 
    private readonly float headerSpacing = 14f; 
    private readonly float verticalPadding = 10f; 
    
    private readonly float dividerHeight = 2f;   
    private readonly float dividerSpacing = 24f; 

    private readonly string[] actionDisplayNames = { "이동", "텔레포트", "대기", "변동 좌표 타격 (캐릭터 기준)", "고정 좌표 타격 (메테오 등)", "원거리 투사체 발사" };
    private readonly string[] targetDisplayNames = { "지정 좌표", "오브젝트(태그) 추적", "특정 방향 고정", "오브젝트 추적 (X축만)", "오브젝트 추적 (Z축만)" };

    public override void OnGUI(Rect position, SerializedProperty property, GUIContent label)
    {
        // ▼ [버그 방지] ActionData에 신규 변수가 아직 반영되지 않았다면 UI 그리기를 중단합니다.
        if (property.FindPropertyRelative("capturePositionAtExecution") == null)
        {
            EditorGUI.HelpBox(position, "ActionData 클래스가 최신 상태가 아닙니다. ActionSequenceSO.cs를 저장하고 컴파일을 기다려주세요.", MessageType.Warning);
            return;
        }

        bool originalWideMode = EditorGUIUtility.wideMode;
        EditorGUIUtility.wideMode = true; 

        EditorGUI.BeginProperty(position, label, property);
        
        var showGizmo = property.FindPropertyRelative("showGizmo");
        var actionType = property.FindPropertyRelative("actionType");
        var executeParallel = property.FindPropertyRelative("executeParallel"); 
        
        var playAnimation = property.FindPropertyRelative("playAnimation"); 
        var animationName = property.FindPropertyRelative("animationName");
        
        var useAcceleration = property.FindPropertyRelative("useAcceleration");
        var targetType = property.FindPropertyRelative("targetType");
        var targetPosition = property.FindPropertyRelative("targetPosition");
        var targetTag = property.FindPropertyRelative("targetTag");
        var offset = property.FindPropertyRelative("offset");
        var trackMargin = property.FindPropertyRelative("trackMargin");

        var stopOnTargetReached = property.FindPropertyRelative("stopOnTargetReached");
        var distanceMode = property.FindPropertyRelative("distanceMode");
        var targetShape = property.FindPropertyRelative("targetShape");
        var shapeOffset = property.FindPropertyRelative("shapeOffset");
        var attackBoxSize = property.FindPropertyRelative("attackBoxSize");
        var stopDistance = property.FindPropertyRelative("stopDistance");

        var stopOnTimeLimit = property.FindPropertyRelative("stopOnTimeLimit");
        var timeLimit = property.FindPropertyRelative("timeLimit");

        var damage = property.FindPropertyRelative("damage");
        var knockbackForce = property.FindPropertyRelative("knockbackForce"); 
        var attackShape = property.FindPropertyRelative("attackShape");
        var attackRadius = property.FindPropertyRelative("attackRadius");
        var attackHeight = property.FindPropertyRelative("attackHeight");
        var attackHitBoxSize = property.FindPropertyRelative("attackHitBoxSize");

        int typeIndex = actionType.enumValueIndex;

        Rect rect = new Rect(position.x, position.y + verticalPadding, position.width, lineHeight);
        
        actionType.enumValueIndex = EditorGUI.Popup(rect, "액션 타입", typeIndex, actionDisplayNames);
        rect.y += lineHeight + spacing;

        Rect parallelRect = new Rect(rect.x, rect.y, rect.width / 2, rect.height);
        Rect gizmoRect = new Rect(rect.x + rect.width / 2, rect.y, rect.width / 2, rect.height);
        
        float originalLabelWidth = EditorGUIUtility.labelWidth;
        EditorGUIUtility.labelWidth = 80f;
        EditorGUI.PropertyField(parallelRect, executeParallel, new GUIContent("병렬 실행"));
        EditorGUIUtility.labelWidth = 100f;
        EditorGUI.PropertyField(gizmoRect, showGizmo, new GUIContent("기즈모 표시"));
        EditorGUIUtility.labelWidth = originalLabelWidth;
        rect.y += lineHeight + spacing;

        EditorGUI.PropertyField(rect, playAnimation, new GUIContent("애니메이션 재생"));
        rect.y += lineHeight + spacing;
        
        if (playAnimation.boolValue)
        {
            EditorGUI.PropertyField(rect, animationName, new GUIContent(" ㄴ 애니메이션 이름"));
            rect.y += lineHeight + spacing;
        }

        if (typeIndex == (int)ActionType.Move)
        {
            rect.y += headerSpacing - spacing; 
            EditorGUI.LabelField(rect, "이동 방식 설정", EditorStyles.boldLabel);
            rect.y += lineHeight + spacing;
            
            targetType.enumValueIndex = EditorGUI.Popup(rect, "목표 기준", targetType.enumValueIndex, targetDisplayNames);
            rect.y += lineHeight + spacing;

            if (targetType.enumValueIndex == (int)TargetType.SpecificPosition)
            {
                var captureProp = property.FindPropertyRelative("capturePositionAtExecution");
                EditorGUI.PropertyField(rect, captureProp, new GUIContent("실행 시점에 좌표 캡처"));
                rect.y += lineHeight + spacing;

                if (captureProp.boolValue)
                {
                    EditorGUI.PropertyField(rect, property.FindPropertyRelative("capturePositionTag"), new GUIContent("캡처할 타겟 태그"));
                    rect.y += lineHeight + spacing;
                }
                else
                {
                    EditorGUI.PropertyField(rect, targetPosition, new GUIContent("지정 좌표"));
                    rect.y += lineHeight + spacing;
                }
            }
            else if (targetType.enumValueIndex == (int)TargetType.TrackObject || 
                     targetType.enumValueIndex == (int)TargetType.TrackObjectXOnly || 
                     targetType.enumValueIndex == (int)TargetType.TrackObjectZOnly)
            {
                EditorGUI.PropertyField(rect, targetTag, new GUIContent("타겟 태그"));
                rect.y += lineHeight + spacing;
                
                EditorGUI.PropertyField(rect, trackMargin, new GUIContent("추적 마진 거리(Margin)"));
                rect.y += lineHeight + spacing;

                EditorGUI.PropertyField(rect, property.FindPropertyRelative("targetGizmoShape"), new GUIContent("타겟 도형"));
                rect.y += lineHeight + spacing;
            }
            else if (targetType.enumValueIndex == (int)TargetType.Direction)
            {
                EditorGUI.PropertyField(rect, property.FindPropertyRelative("moveDirection"), new GUIContent("이동 방향 (로컬/월드 무관)"));
                rect.y += lineHeight + spacing;
            }

            if (targetType.enumValueIndex != (int)TargetType.Direction)
            {
                EditorGUI.PropertyField(rect, offset, new GUIContent("목표점 오프셋(Offset)"));
                rect.y += lineHeight + spacing;
            }

            rect.y += headerSpacing - spacing;
            EditorGUI.LabelField(rect, "종료 조건 설정", EditorStyles.boldLabel);
            rect.y += lineHeight + spacing;
            
            if (targetType.enumValueIndex != (int)TargetType.Direction)
            {
                EditorGUI.PropertyField(rect, stopOnTargetReached, new GUIContent("목표 도달 시 종료"));
                rect.y += lineHeight + spacing;
                
                if (stopOnTargetReached.boolValue)
                {
                    distanceMode.enumValueIndex = EditorGUI.Popup(rect, " ㄴ 거리 측정 방식", distanceMode.enumValueIndex, new string[] { "Distance 3D", "Attack Box" });
                    rect.y += lineHeight + spacing;

                    targetShape.enumValueIndex = EditorGUI.Popup(rect, " ㄴ 감지 도형 선택", targetShape.enumValueIndex, new string[] { "원형 (Sphere)", "사각형 (Box)", "점 (Point)" });
                    rect.y += lineHeight + spacing;

                    if (distanceMode.enumValueIndex == (int)DistanceCheckMode.AttackBox)
                    {
                        bool isTrackXOnly = targetType.enumValueIndex == (int)TargetType.TrackObjectXOnly;
                        bool isTrackZOnly = targetType.enumValueIndex == (int)TargetType.TrackObjectZOnly;

                        SerializedProperty xProp = shapeOffset.FindPropertyRelative("x");
                        SerializedProperty yProp = shapeOffset.FindPropertyRelative("y");
                        SerializedProperty zProp = shapeOffset.FindPropertyRelative("z");

                        if (isTrackZOnly) xProp.floatValue = 0f;
                        if (isTrackXOnly) zProp.floatValue = 0f;

                        Rect offsetLabelRect = new Rect(rect.x, rect.y, EditorGUIUtility.labelWidth, lineHeight);
                        EditorGUI.LabelField(offsetLabelRect, " ㄴ 도형 오프셋(Offset)");

                        float fieldWidth = (rect.width - EditorGUIUtility.labelWidth) / 3f;
                        Rect xRect = new Rect(rect.x + EditorGUIUtility.labelWidth, rect.y, fieldWidth - 2f, lineHeight);
                        Rect yRect = new Rect(xRect.x + fieldWidth, rect.y, fieldWidth - 2f, lineHeight);
                        Rect zRect = new Rect(yRect.x + fieldWidth, rect.y, fieldWidth - 2f, lineHeight);

                        float tempLabelWidth = EditorGUIUtility.labelWidth;
                        int tempIndent = EditorGUI.indentLevel; 
                        
                        EditorGUI.indentLevel = 0; 
                        EditorGUIUtility.labelWidth = 14f;

                        EditorGUI.BeginDisabledGroup(isTrackZOnly);
                        EditorGUI.PropertyField(xRect, xProp, new GUIContent("X"));
                        EditorGUI.EndDisabledGroup();

                        EditorGUI.PropertyField(yRect, yProp, new GUIContent("Y"));

                        EditorGUI.BeginDisabledGroup(isTrackXOnly);
                        EditorGUI.PropertyField(zRect, zProp, new GUIContent("Z"));
                        EditorGUI.EndDisabledGroup();

                        EditorGUI.indentLevel = tempIndent;
                        EditorGUIUtility.labelWidth = tempLabelWidth;
                        
                        rect.y += lineHeight + spacing;
                    }

                    if (targetShape.enumValueIndex == (int)TargetShape.Point)
                    {
                        EditorGUI.PropertyField(rect, stopDistance, new GUIContent(" ㄴ 판정 거리(오차 범위)"));
                        rect.y += lineHeight + spacing;
                    }
                    else if (targetShape.enumValueIndex == (int)TargetShape.Sphere)
                    {
                        EditorGUI.PropertyField(rect, stopDistance, new GUIContent(" ㄴ 감지 반지름"));
                        rect.y += lineHeight + spacing;
                    }
                    else
                    {
                        EditorGUI.PropertyField(rect, attackBoxSize, new GUIContent(" ㄴ 감지 박스 크기(Size)"));
                        rect.y += lineHeight + spacing;
                    }
                }
            }

            EditorGUI.PropertyField(rect, stopOnTimeLimit, new GUIContent("시간 제한으로 종료"));
            rect.y += lineHeight + spacing;
            
            if (stopOnTimeLimit.boolValue)
            {
                EditorGUI.PropertyField(rect, timeLimit, new GUIContent(" ㄴ 제한 시간(초)"));
                rect.y += lineHeight + spacing;
            }

            rect.y += headerSpacing - spacing;
            EditorGUI.LabelField(rect, "속도 및 가속 설정", EditorStyles.boldLabel);
            rect.y += lineHeight + spacing;

            EditorGUI.PropertyField(rect, useAcceleration, new GUIContent("가속 사용"));
            rect.y += lineHeight + spacing;
            
            if (useAcceleration.boolValue)
            {
                EditorGUI.PropertyField(rect, property.FindPropertyRelative("startSpeed"), new GUIContent("시작 속도"));
                rect.y += lineHeight + spacing;
                
                EditorGUI.PropertyField(rect, property.FindPropertyRelative("acceleration"), new GUIContent("가속도"));
                rect.y += lineHeight + spacing;
            }

            EditorGUI.PropertyField(rect, property.FindPropertyRelative("speed"), new GUIContent(useAcceleration.boolValue ? "최대 속도" : "이동 속도"));
            rect.y += lineHeight + spacing;
        }
        else if (typeIndex == (int)ActionType.Teleport)
        {
            rect.y += headerSpacing - spacing; 
            EditorGUI.LabelField(rect, "텔레포트 설정", EditorStyles.boldLabel);
            rect.y += lineHeight + spacing;

            targetType.enumValueIndex = EditorGUI.Popup(rect, "목표 기준", targetType.enumValueIndex, targetDisplayNames);
            rect.y += lineHeight + spacing;

            if (targetType.enumValueIndex == 0) 
            {
                var captureProp = property.FindPropertyRelative("capturePositionAtExecution");
                EditorGUI.PropertyField(rect, captureProp, new GUIContent("실행 시점에 좌표 캡처"));
                rect.y += lineHeight + spacing;

                if (captureProp.boolValue)
                {
                    EditorGUI.PropertyField(rect, property.FindPropertyRelative("capturePositionTag"), new GUIContent("캡처할 타겟 태그"));
                    rect.y += lineHeight + spacing;
                }
                else
                {
                    EditorGUI.PropertyField(rect, targetPosition, new GUIContent("지정 좌표"));
                    rect.y += lineHeight + spacing;
                }
            }
            else 
            {
                EditorGUI.PropertyField(rect, targetTag, new GUIContent("타겟 태그"));
                rect.y += lineHeight + spacing;

                EditorGUI.PropertyField(rect, property.FindPropertyRelative("targetGizmoShape"), new GUIContent("타겟 도형"));
                rect.y += lineHeight + spacing;
            }
            
            EditorGUI.PropertyField(rect, offset, new GUIContent("오프셋(Offset)"));
            rect.y += lineHeight + spacing;
        }
        else if (typeIndex == (int)ActionType.Wait)
        {
            rect.y += headerSpacing - spacing; 
            EditorGUI.LabelField(rect, "대기 설정", EditorStyles.boldLabel);
            rect.y += lineHeight + spacing;

            EditorGUI.PropertyField(rect, timeLimit, new GUIContent("대기 시간(초)"));
            rect.y += lineHeight + spacing;
        }
        else if (typeIndex == (int)ActionType.VariableAttack || typeIndex == (int)ActionType.FixedAttack)
        {
            rect.y += headerSpacing - spacing; 
            EditorGUI.LabelField(rect, typeIndex == (int)ActionType.VariableAttack ? "변동 좌표 타격 설정" : "고정 좌표 타격 설정", EditorStyles.boldLabel);
            rect.y += lineHeight + spacing;

            damage.floatValue = EditorGUI.FloatField(rect, "공격력(Damage)", damage.floatValue);
            rect.y += lineHeight + spacing;

            EditorGUI.PropertyField(rect, knockbackForce, new GUIContent("넉백 힘(X, Y, Z)"));
            rect.y += lineHeight + spacing;

            attackShape.enumValueIndex = EditorGUI.Popup(rect, "공격 범위 도형", attackShape.enumValueIndex, new string[] { "원형 (Sphere)", "사각형 (Box)", "원기둥 (Cylinder)" });
            rect.y += lineHeight + spacing;

            if (attackShape.enumValueIndex == (int)AttackShape.Sphere)
            {
                EditorGUI.PropertyField(rect, attackRadius, new GUIContent("반지름(Radius)"));
                rect.y += lineHeight + spacing;
            }
            else if (attackShape.enumValueIndex == (int)AttackShape.Box)
            {
                EditorGUI.PropertyField(rect, attackHitBoxSize, new GUIContent("박스 크기(Size)"));
                rect.y += lineHeight + spacing;
            }
            else if (attackShape.enumValueIndex == (int)AttackShape.Cylinder)
            {
                EditorGUI.PropertyField(rect, attackRadius, new GUIContent("밑면 반지름(Radius)"));
                rect.y += lineHeight + spacing;
                EditorGUI.PropertyField(rect, attackHeight, new GUIContent("높이(Height)"));
                rect.y += lineHeight + spacing;
            }

            if (typeIndex == (int)ActionType.FixedAttack)
            {
                targetType.enumValueIndex = EditorGUI.Popup(rect, "타겟 기준", targetType.enumValueIndex, targetDisplayNames);
                rect.y += lineHeight + spacing;

                if (targetType.enumValueIndex == (int)TargetType.TrackObject ||
                    targetType.enumValueIndex == (int)TargetType.TrackObjectXOnly ||
                    targetType.enumValueIndex == (int)TargetType.TrackObjectZOnly)
                {
                    EditorGUI.PropertyField(rect, property.FindPropertyRelative("targetTag"), new GUIContent("타겟 태그"));
                    rect.y += lineHeight + spacing;
                }
                else if (targetType.enumValueIndex == (int)TargetType.SpecificPosition)
                {
                    var captureProp = property.FindPropertyRelative("capturePositionAtExecution");
                    EditorGUI.PropertyField(rect, captureProp, new GUIContent("실행 시점에 좌표 캡처"));
                    rect.y += lineHeight + spacing;

                    if (captureProp.boolValue)
                    {
                        EditorGUI.PropertyField(rect, property.FindPropertyRelative("capturePositionTag"), new GUIContent("캡처할 타겟 태그"));
                        rect.y += lineHeight + spacing;
                    }
                    else
                    {
                        EditorGUI.PropertyField(rect, targetPosition, new GUIContent("지정 좌표"));
                        rect.y += lineHeight + spacing;
                    }
                }

                EditorGUI.PropertyField(rect, property.FindPropertyRelative("offset"), new GUIContent("타격 오프셋(Offset)"));
                rect.y += lineHeight + spacing;
            }
            else
            {
                EditorGUI.PropertyField(rect, property.FindPropertyRelative("attackOffset"), new GUIContent("공격 오프셋(Offset)"));
                rect.y += lineHeight + spacing;
            }
        }
        else if (typeIndex == (int)ActionType.RangedAttack)
        {
            rect.y += headerSpacing - spacing; 
            EditorGUI.LabelField(rect, "원거리 투사체 발사 설정", EditorStyles.boldLabel);
            rect.y += lineHeight + spacing;

            EditorGUI.PropertyField(rect, property.FindPropertyRelative("projectilePrefab"), new GUIContent("투사체 프리팹"));
            rect.y += lineHeight + spacing;

            EditorGUI.PropertyField(rect, property.FindPropertyRelative("projectileCount"), new GUIContent("발사 갯수(Count)"));
            rect.y += lineHeight + spacing;

            EditorGUI.PropertyField(rect, property.FindPropertyRelative("projectileInterval"), new GUIContent("발사 간격(초)"));
            rect.y += lineHeight + spacing;

            damage.floatValue = EditorGUI.FloatField(rect, "공격력(Damage)", damage.floatValue);
            rect.y += lineHeight + spacing;

            EditorGUI.PropertyField(rect, knockbackForce, new GUIContent("넉백 힘(X, Y, Z)"));
            rect.y += lineHeight + spacing;

            EditorGUI.PropertyField(rect, property.FindPropertyRelative("projectileSpeed"), new GUIContent("투사체 비행 속도"));
            rect.y += lineHeight + spacing;

            EditorGUI.PropertyField(rect, property.FindPropertyRelative("projectileLifeTime"), new GUIContent("투사체 파괴 시간(수명)"));
            rect.y += lineHeight + spacing;

            EditorGUI.PropertyField(rect, property.FindPropertyRelative("attackOffset"), new GUIContent("투사체 생성 위치(Offset)"));
            rect.y += lineHeight + spacing;

            targetType.enumValueIndex = EditorGUI.Popup(rect, "발사 방향 기준", targetType.enumValueIndex, targetDisplayNames);
            rect.y += lineHeight + spacing;

            if (targetType.enumValueIndex == (int)TargetType.TrackObject ||
                targetType.enumValueIndex == (int)TargetType.TrackObjectXOnly ||
                targetType.enumValueIndex == (int)TargetType.TrackObjectZOnly)
            {
                EditorGUI.PropertyField(rect, property.FindPropertyRelative("targetTag"), new GUIContent("조준할 타겟 태그"));
                rect.y += lineHeight + spacing;
            }
            else if (targetType.enumValueIndex == (int)TargetType.SpecificPosition)
            {
                var captureProp = property.FindPropertyRelative("capturePositionAtExecution");
                EditorGUI.PropertyField(rect, captureProp, new GUIContent("실행 시점에 좌표 캡처"));
                rect.y += lineHeight + spacing;

                if (captureProp.boolValue)
                {
                    EditorGUI.PropertyField(rect, property.FindPropertyRelative("capturePositionTag"), new GUIContent("캡처할 타겟 태그"));
                    rect.y += lineHeight + spacing;
                }
                else
                {
                    EditorGUI.PropertyField(rect, targetPosition, new GUIContent("지정 좌표"));
                    rect.y += lineHeight + spacing;
                }
            }
            else if (targetType.enumValueIndex == (int)TargetType.Direction)
            {
                EditorGUI.PropertyField(rect, property.FindPropertyRelative("moveDirection"), new GUIContent("발사 방향 (로컬)"));
                rect.y += lineHeight + spacing;
            }
        }

        DrawCustomDivider(new Rect(position.x, position.yMax - dividerSpacing, position.width, dividerHeight));
        
        EditorGUIUtility.wideMode = originalWideMode;
        EditorGUI.EndProperty();
    }

    private void DrawCustomDivider(Rect rect)
    {
        rect.y += dividerSpacing / 2f; 
        EditorGUI.DrawRect(rect, new Color(0.3f, 0.3f, 0.3f, 1f));
    }

    public override float GetPropertyHeight(SerializedProperty property, GUIContent label)
    {
        if (property.FindPropertyRelative("capturePositionAtExecution") == null)
        {
            return 40f; 
        }

        int fieldLineCount = 3; 
        if (property.FindPropertyRelative("playAnimation").boolValue) fieldLineCount++;

        int headerCount = 0; 
        int typeIndex = property.FindPropertyRelative("actionType").enumValueIndex;

        if (typeIndex == (int)ActionType.Move)
        {
            var targetType = property.FindPropertyRelative("targetType").enumValueIndex;
            headerCount += 3; 
            
            fieldLineCount += 1; 

            if (targetType == (int)TargetType.SpecificPosition)
            {
                fieldLineCount += 2; 
            }
            else if (targetType == (int)TargetType.TrackObject || 
                     targetType == (int)TargetType.TrackObjectXOnly || 
                     targetType == (int)TargetType.TrackObjectZOnly)
            {
                fieldLineCount += 3; 
            }
            else if (targetType == (int)TargetType.Direction)
            {
                fieldLineCount += 1; 
            }
            
            if (targetType != (int)TargetType.Direction)
            {
                fieldLineCount += 1; 
                fieldLineCount += 1; 
                
                if (property.FindPropertyRelative("stopOnTargetReached").boolValue) 
                {
                    fieldLineCount += 3; 
                    if (property.FindPropertyRelative("distanceMode").enumValueIndex == (int)DistanceCheckMode.AttackBox)
                    {
                        fieldLineCount += 1; 
                    }
                } 
            }
            
            fieldLineCount += 1; 
            if (property.FindPropertyRelative("stopOnTimeLimit").boolValue) fieldLineCount++; 

            fieldLineCount += 2; 
            if (property.FindPropertyRelative("useAcceleration").boolValue) fieldLineCount += 2; 
        }
        else if (typeIndex == (int)ActionType.Teleport)
        {
            headerCount += 1;    
            fieldLineCount += 2; 
            
            if (property.FindPropertyRelative("targetType").enumValueIndex == 0) 
            {
                fieldLineCount += 2; 
            }
            else
            {
                fieldLineCount += 2; 
            }
        }
        else if (typeIndex == (int)ActionType.Wait)
        {
            headerCount += 1;    
            fieldLineCount += 1; 
        }
        else if (typeIndex == (int)ActionType.VariableAttack || typeIndex == (int)ActionType.FixedAttack)
        {
            headerCount += 1; 
            fieldLineCount += 4; 
            
            if (property.FindPropertyRelative("attackShape").enumValueIndex == (int)AttackShape.Cylinder)
            {
                fieldLineCount++; 
            }
            
            if (typeIndex == (int)ActionType.FixedAttack)
            {
                fieldLineCount += 2; 
                var tType = property.FindPropertyRelative("targetType").enumValueIndex;
                if (tType == (int)TargetType.TrackObject || tType == (int)TargetType.TrackObjectXOnly || tType == (int)TargetType.TrackObjectZOnly)
                    fieldLineCount += 1; 
                else if (tType == (int)TargetType.SpecificPosition)
                    fieldLineCount += 2; 
            }
            else
            {
                fieldLineCount += 1; 
            }
        }
        else if (typeIndex == (int)ActionType.RangedAttack)
        {
            headerCount += 1; 
            fieldLineCount += 9; 
            
            var tType = property.FindPropertyRelative("targetType").enumValueIndex;
            if (tType == (int)TargetType.SpecificPosition)
            {
                fieldLineCount += 2; 
            }
            else
            {
                fieldLineCount += 1;
            }
        }

        float totalHeight = ((lineHeight + spacing) * fieldLineCount) 
                          + ((lineHeight + spacing) * headerCount) 
                          + (headerSpacing * headerCount)
                          + (verticalPadding * 2f) 
                          + dividerSpacing;        

        return totalHeight;
    }
}